menu "Application I2C Configurations"

    config APP_I2C_SDA_PIN
        int "GPIO number for I2C SDA"
        default 8
        help
            GPIO pin used for I2C SDA data line.

    config APP_I2C_SCL_PIN
        int "GPIO number for I2C SCL"
        default 9
        help
            GPIO pin used for I2C SCL clock line.

    config APP_I2C_CLOCK_HZ
        int "MT6701 I2C clock frequency (Hz)"
        range 100000 1000000
        default 1000000
        help
            I2C clock used to read the MT6701. The sensor supports up to
            1 MHz, provided the physical bus meets its 150 ns maximum
            SDA/SCL rise and fall times. Use 400000 as a conservative fallback.

endmenu

menu "Control Time-Series Capture"

    config APP_TIMESERIES_AUTO_CAPTURE
        bool "Automatically capture around reference steps"
        default n
        help
            Arm the reusable time-series recorder shortly before each new
            closed-loop reference step. A full capture remains preserved until
            a transport or application calls CLEAR. Keep this disabled when an
            external host such as Octave owns the ARM/CLEAR workflow.

    config APP_TIMESERIES_DEFAULT_SAMPLE_RATE_HZ
        int "Default automatic capture rate (Hz)"
        depends on APP_TIMESERIES_AUTO_CAPTURE
        range 1 1000
        default 500
        help
            Runtime sample rate used by automatic captures. It must divide the
            1 kHz control rate exactly. A future USB command may select a
            different valid rate for each capture.

    config APP_TIMESERIES_PRETRIGGER_MS
        int "Time before a reference step to start capture (ms)"
        depends on APP_TIMESERIES_AUTO_CAPTURE
        range 1 10000
        default 1000
        help
            Start the automatic recording this long before the next 600/900
            RPM transition. Each transition is armed at most once.

endmenu

menu "Motor Test Profile"

    config APP_MOTOR_OPEN_LOOP_TEST
        bool "Enable the host-requested open-loop calibration profile"
        default n
        help
            Allow CAL START to bypass the speed PID and run low/high/low duty
            stages followed by COAST. A regular ARM always starts a fresh
            alternating 600/900 RPM closed-loop experiment.

    config APP_OPEN_LOOP_DUTY_LOW_PERCENT
        int "Open-loop low duty (percent)"
        depends on APP_MOTOR_OPEN_LOOP_TEST
        range 0 100
        default 40

    config APP_OPEN_LOOP_DUTY_HIGH_PERCENT
        int "Open-loop high duty (percent)"
        depends on APP_MOTOR_OPEN_LOOP_TEST
        range 0 100
        default 55

    config APP_OPEN_LOOP_STAGE_SECONDS
        int "Open-loop stage duration (seconds)"
        depends on APP_MOTOR_OPEN_LOOP_TEST
        range 1 120
        default 8
        help
            Eight seconds per stage lets a five-channel 500 Hz calibration
            capture include low/high/low plateaus and return to COAST before
            the 128 KiB recorder buffer becomes full.

endmenu
